# .env banate hobe ei file copy kore (cp .env.example .env)
# <host> er jaygay tomar actual DB server-er IP/hostname dao

# PostgreSQL — customer_calls table
DATABASE_URL=postgresql://dev_user:password@<host>:5432/dcmv2
TABLE_SCHEMA=public
TABLE_NAME=customer_calls

# SQL Server — dbo.testMaster order table
SQLSERVER_HOST=<sqlserver-ip>
SQLSERVER_DB=test
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=<password>
